---
import chevronDown from "../../assets/bootstrap/chevron-down.svg";

interface Props {
  width?: number;
  height?: number;
}

const { width = 24, height = 24 } = Astro.props;
---

<img
  src={chevronDown.src}
  width={width}
  height={height}
  alt=""
  class="pulsate"
/>

<style>
  @keyframes pulsate {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(16px);
    }
    100% {
      transform: translateY(0);
    }
  }

  .pulsate {
    animation: pulsate 3s ease-in-out infinite;
    filter: brightness(0) invert(1);
  }
</style>
