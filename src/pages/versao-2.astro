---
import background from "../assets/background2.jpg";
import logo from "../assets/medplus-mark.svg";
import photos from "../assets/photosHor.png";
import coin from "../assets/bootstrap/coin.svg";
import people from "../assets/bootstrap/people.svg";
import stethoscope from "../assets/bootstrap/heart-pulse.svg";
import doctor from "../assets/bootstrap/person-badge.svg";
import piggy from "../assets/bootstrap/piggy-bank.svg";
import plane from "../assets/bootstrap/airplane.svg";
import life from "../assets/bootstrap/hospital.svg";
import hand from "../assets/bootstrap/hand-index-thumb.svg";
import handPng from "../assets/bootstrap/hand-index-thumb.svg";
import globe from "../assets/bootstrap/globe-americas.svg";
import bank from "../assets/bootstrap/bank.svg";
import shield from "../assets/bootstrap/shield-check.svg";
import ica from "../assets/ica.svg";
import dominion from "../assets/dominion.svg";
import shieldPartner from "../assets/shield-bank.svg";
import partner1 from "../assets/partners/1.png";
import partner2 from "../assets/partners/2.png";
import partner3 from "../assets/partners/3.png";
import partner4 from "../assets/partners/4.png";
import partner5 from "../assets/partners/5.png";
import partner6 from "../assets/partners/6.webp";
import partner7 from "../assets/partners/7.svg";

const products = [
  { icon: coin, title: "Seguro de Renda", tag: "Carreira", text: "Mantém sua renda durante afastamentos por doença, acidente ou cirurgia, para que sua recuperação venha primeiro." },
  { icon: people, title: "Seguro de Vida", tag: "Família", text: "Proteção para beneficiários e coberturas que também podem ser utilizadas em vida." },
  { icon: stethoscope, title: "Doenças Graves", tag: "Saúde", text: "Ajuda financeira para tratamento e manutenção do padrão de vida após um diagnóstico grave." },
  { icon: doctor, title: "Responsabilidade Civil", tag: "Profissão", text: "Custos de defesa, indenizações e acordos relacionados a danos involuntários no exercício profissional." },
  { icon: piggy, title: "Previdência Privada", tag: "Futuro", text: "Acumulação de recursos para uma aposentadoria conectada aos seus objetivos." },
  { icon: plane, title: "Seguro Viagem", tag: "Mobilidade", text: "Assistência médica, odontológica, acidentes e extravio de bagagens durante viagens." },
  { icon: life, title: "Saúde Nacional e Global", tag: "Cuidado", text: "Opções nacionais e internacionais analisadas de acordo com o seu perfil." },
  { icon: hand, title: "Seguro das Mãos", tag: "Especialistas", text: "Proteção financeira por invalidez permanente total por acidente para quem depende das mãos para trabalhar." },
];
const investments = [
  { icon: handPng, title: "P2P Lending", text: "Rentabilidade atrativa com liquidez de curto e médio prazo." },
  { icon: shield, title: "Conta Corrente Protegida", text: "Transações internacionais e compra de moedas com praticidade." },
  { icon: globe, title: "Investimentos Internacionais", text: "Diversificação global com acesso a portfólios de grandes bancos." },
  { icon: bank, title: "Correspondente Bancário", text: "Soluções nacionais com acompanhamento consultivo." },
];
const partners = [partner1, partner2, partner3, partner4, partner5, partner6, partner7];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Med Plus: seguros e investimentos com consultoria independente." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Med Plus — Versão Contemporânea</title>
  </head>
  <body>
    <header>
      <a class="logo" href="#top"><img src={logo.src} alt="Med Plus Corretora de Seguros" /></a>
      <nav aria-label="Navegação principal"><a href="#sobre">A Med Plus</a><a href="#solucoes">Soluções</a><a href="#investimentos">Investimentos</a></nav>
      <a class="nav-cta" href="https://wa.me/5512996146999"><span>●</span> Consultoria agora</a>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-main">
          <div class="hero-copy"><p class="overline">Seguros + investimentos</p><h1>Seu futuro não precisa de <span>improviso.</span></h1><p>Consultoria independente para proteger sua vida, sua carreira e seu patrimônio com escolhas que fazem sentido para você.</p><a class="big-button" href="https://wa.me/5512996146999">Vamos conversar <span>↗</span></a></div>
          <div class="hero-image" style={`--image: url(${background.src})`}><div class="stamp"><strong>25</strong><span>anos de<br />experiência</span></div></div>
        </div>
        <div class="ticker" aria-label="Destaques"><div>INDEPENDÊNCIA <span>✦</span> ESCUTA ATENTA <span>✦</span> EXPERIÊNCIA <span>✦</span> PROTEÇÃO SOB MEDIDA <span>✦</span></div></div>
      </section>

      <section class="intro" id="sobre">
        <div class="section-mark">01 / SOBRE</div>
        <div><h2>Você não precisa entender de seguros.<br /><span>Nós precisamos entender você.</span></h2></div>
        <div class="intro-copy"><p>Mais do que vender produtos, a Med Plus oferece consultoria. Buscamos nas principais seguradoras do mercado as alternativas específicas para cada necessidade.</p><p>Por trabalharmos com diversas seguradoras, mantemos independência e imparcialidade na hora de indicar a solução mais adequada.</p></div>
      </section>

      <section class="photo-break" style={`--photo: url(${photos.src})`}><p>Há mais de 25 anos<br /><strong>protegendo vidas.</strong></p></section>

      <section class="products" id="solucoes">
        <div class="section-title"><div class="section-mark">02 / SOLUÇÕES</div><h2>Proteção em todas as frentes.</h2><p>Da sua renda às grandes decisões de vida. Conheça as principais soluções e fale com a gente para uma análise personalizada.</p></div>
        <div class="product-grid">
          {products.map((item, index) => (
            <article>
              <div class="card-top"><span>{item.tag}</span><b>0{index + 1}</b></div>
              <img src={item.icon.src} alt="" />
              <h3>{item.title}</h3><p>{item.text}</p>
              {item.title === "Responsabilidade Civil" ? <a href="https://www.rc4vc.com/cotacao/medplus" target="_blank" rel="noreferrer">Cotar on-line ↗</a> : <a href="https://wa.me/5512996146999">Falar com consultor ↗</a>}
            </article>
          ))}
        </div>
      </section>

      <section class="invest" id="investimentos">
        <div class="invest-heading"><div class="section-mark">03 / INVESTIMENTOS</div><h2>Seu patrimônio.<br />Mais possibilidades.</h2><p>Alternativas nacionais e internacionais para diversificar com visão de longo prazo.</p></div>
        <div class="invest-grid">{investments.map((item) => <article><img src={item.icon.src} alt="" /><h3>{item.title}</h3><p>{item.text}</p><a href="https://wa.me/5512996146999" aria-label={`Saiba mais sobre ${item.title}`}>↗</a></article>)}</div>
        <div class="official"><span>Parceiros oficiais</span><img src={ica.src} alt="ICA" /><img src={shieldPartner.src} alt="Shield Bank" /><img src={dominion.src} alt="Dominion" /></div>
      </section>

      <section class="mdrt"><div class="mdrt-art"><span class="mdrt-backdrop">TOP</span><div class="mdrt-wordmark" aria-label="MDRT, marca registrada">MDRT<sup>®</sup></div></div><div><div class="section-mark">RECONHECIMENTO</div><h2>Membro do MDRT<sup>®</sup>.</h2><p>Associação exclusiva de corretores de seguros com mais de <strong>US$ 1 milhão em seguro de vida.</strong></p></div></section>

      <section class="partner-section"><div><div class="section-mark">04 / REDE</div><h2>Grandes nomes.<br />Uma recomendação independente.</h2></div><div class="partner-grid">{partners.map((partner) => <div><img src={partner.src} alt="Seguradora parceira" loading="lazy" /></div>)}</div></section>

      <section class="final-cta"><p>Pronto para proteger o que vem pela frente?</p><a href="https://wa.me/5512996146999">Fale com a Med Plus <span>↗</span></a></section>
    </main>

    <footer><div class="footer-top"><img src={logo.src} alt="Med Plus" /><a href="https://www.instagram.com/medpluscorretora/">@medpluscorretora ↗</a></div><div class="footer-grid"><div><h2>Taubaté</h2><p>Rua Dr. Souza Alves, 384 — Sala 504<br />Centro — Taubaté — SP</p></div><div><h2>São José dos Campos</h2><p>Rua Euclides Miragaia, 145 — Sala 610<br />Centro — São José dos Campos — SP</p></div><div><h2>Contato</h2><p>(12) 3633-7199 · 3622-4044<br />(12) 99738-7999 · 99152-7999<br />medpluscorretora@medpluscorretora.com.br</p></div></div><div class="footer-bottom">© 2026 Med Plus Corretora de Seguros.</div></footer>
  </body>
</html>

<style is:global>
  :root { --blue:#006dbb; --acid:#c8ff36; --ink:#061c2a; --cream:#f2f0e8; --white:#fff; --line:#b7c3c8; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; font:400 16px/1.55 "Space Grotesk",sans-serif; color:var(--ink); background:var(--cream); }
  a { color:inherit; }
  h1,h2,h3,p { margin-top:0; }
  h1,h2 { font-family:"Archivo Black",sans-serif; text-transform:uppercase; letter-spacing:-.055em; line-height:.92; }
  header { height:82px; display:flex; align-items:center; padding:0 4vw; gap:44px; background:var(--ink); color:white; }
  .logo img { width:auto; height:52px; display:block; filter:brightness(0) invert(1); }
  header nav { display:flex; gap:28px; margin-left:auto; }
  header nav a { font-size:.9rem; text-decoration:none; text-transform:uppercase; letter-spacing:.06em; }
  .nav-cta { text-decoration:none; color:var(--ink); background:var(--acid); padding:12px 17px; font-weight:700; text-transform:uppercase; font-size:.86rem; }
  .nav-cta span { color:var(--blue); }
  .hero { background:var(--blue); color:white; }
  .hero-main { min-height:calc(100svh - 126px); display:grid; grid-template-columns:1.1fr .9fr; }
  .hero-copy { padding:clamp(50px,7vw,110px) 5vw; display:flex; flex-direction:column; justify-content:center; }
  .overline,.section-mark { font-weight:700; font-size:.76rem; letter-spacing:.14em; text-transform:uppercase; }
  .overline { color:var(--acid); }
  h1 { font-size:clamp(3.8rem,7.8vw,8.8rem); margin:24px 0 30px; max-width:1000px; }
  h1 span { color:var(--acid); }
  .hero-copy>p:not(.overline) { max-width:640px; font-size:clamp(1.05rem,1.7vw,1.35rem); }
  .big-button { display:flex; justify-content:space-between; gap:50px; width:min(100%,360px); background:var(--ink); color:white; padding:18px 22px; margin-top:28px; text-decoration:none; text-transform:uppercase; font-weight:700; }
  .big-button span { color:var(--acid); }
  .hero-image { min-height:580px; background:linear-gradient(rgba(6,28,42,.12),rgba(6,28,42,.2)),var(--image) center/cover; position:relative; clip-path:polygon(12% 0,100% 0,100% 100%,0 100%); }
  .stamp { position:absolute; right:5vw; bottom:5vw; width:180px; aspect-ratio:1; border-radius:50%; background:var(--acid); color:var(--ink); display:flex; align-items:center; justify-content:center; gap:9px; transform:rotate(-8deg); }
  .stamp strong { font-family:"Archivo Black"; font-size:4rem; line-height:1; }
  .stamp span { font-weight:700; text-transform:uppercase; line-height:1.15; }
  .ticker { height:44px; overflow:hidden; background:var(--acid); color:var(--ink); display:flex; align-items:center; white-space:nowrap; font-weight:700; letter-spacing:.07em; }
  .ticker div { font-size:.92rem; }
  .ticker span { margin:0 30px; color:var(--blue); }
  .intro { padding:clamp(90px,11vw,170px) 5vw; display:grid; grid-template-columns:160px 1.1fr .75fr; gap:4vw; }
  .intro h2,.section-title h2,.invest h2,.mdrt h2,.partner-section h2 { font-size:clamp(2.7rem,5.5vw,6.5rem); }
  .intro h2 span { color:var(--blue); }
  .intro-copy { padding-top:4px; color:#52626a; font-size:1.05rem; }
  .photo-break { min-height:390px; display:grid; place-items:center; padding:50px 20px; background:linear-gradient(90deg,rgba(6,28,42,.82),rgba(6,28,42,.48)),var(--photo) center/cover; color:white; text-align:center; }
  .photo-break p { margin:0; font-size:clamp(2rem,5vw,5.4rem); text-transform:uppercase; letter-spacing:-.05em; line-height:1; }
  .photo-break strong { color:var(--acid); }
  .products { background:var(--ink); color:white; padding:clamp(90px,10vw,150px) 5vw; }
  .section-title { display:grid; grid-template-columns:160px 1fr 300px; gap:4vw; align-items:end; margin-bottom:60px; }
  .section-title p { margin-bottom:0; color:#a5b3b9; }
  .product-grid { display:grid; grid-template-columns:repeat(4,1fr); border-left:1px solid #34505e; border-top:1px solid #34505e; }
  .product-grid article { min-height:390px; padding:24px; border-right:1px solid #34505e; border-bottom:1px solid #34505e; display:flex; flex-direction:column; transition:.25s; }
  .product-grid article:hover { background:var(--blue); transform:translateY(-7px); }
  .card-top { display:flex; justify-content:space-between; color:#99acb5; text-transform:uppercase; font-size:.78rem; }
  .product-grid img { width:66px; height:66px; object-fit:contain; margin:40px 0 30px; filter:grayscale(1) brightness(3); }
  .product-grid h3 { font-size:1.55rem; line-height:1.05; text-transform:uppercase; margin-bottom:16px; }
  .product-grid p { color:#a9b9c0; margin-bottom:22px; }
  .product-grid a { margin-top:auto; font-weight:700; color:var(--acid); text-underline-offset:4px; }
  .invest { padding:clamp(90px,11vw,160px) 5vw; background:var(--acid); }
  .invest-heading { display:grid; grid-template-columns:160px 1fr .7fr; gap:4vw; align-items:end; margin-bottom:55px; }
  .invest-heading p { margin-bottom:0; }
  .invest-grid { display:grid; grid-template-columns:repeat(4,1fr); border:2px solid var(--ink); }
  .invest-grid article { min-height:310px; padding:25px; border-right:2px solid var(--ink); position:relative; }
  .invest-grid article:last-child { border-right:0; }
  .invest-grid img { width:58px; height:58px; object-fit:contain; margin-bottom:46px; }
  .invest-grid h3 { font-size:1.35rem; text-transform:uppercase; line-height:1.1; }
  .invest-grid a { position:absolute; bottom:22px; right:22px; font-size:1.8rem; text-decoration:none; }
  .official { margin-top:45px; display:flex; align-items:center; gap:40px; flex-wrap:wrap; text-transform:uppercase; font-weight:700; }
  .official img { max-width:145px; max-height:54px; object-fit:contain; }
  .mdrt { padding:100px 5vw; background:var(--blue); color:white; display:grid; grid-template-columns:.65fr 1.35fr; gap:8vw; align-items:center; }
  .mdrt-art { position:relative; min-height:330px; display:grid; place-items:center; }
  .mdrt-backdrop { position:absolute; font:400 clamp(9rem,22vw,24rem)/1 "Archivo Black"; color:rgba(255,255,255,.07); }
  .mdrt-wordmark { position:relative; font:700 clamp(4.6rem,9vw,8.5rem)/.85 Georgia,"Times New Roman",serif; letter-spacing:-.075em; }
  .mdrt-wordmark sup,.mdrt h2 sup { font:700 .2em/1 "Space Grotesk",sans-serif; letter-spacing:0; vertical-align:top; margin-left:.12em; }
  .mdrt p { max-width:720px; font-size:1.4rem; }
  .mdrt strong { color:var(--acid); }
  .partner-section { padding:clamp(90px,10vw,150px) 5vw; display:grid; grid-template-columns:.8fr 1.2fr; gap:7vw; align-items:start; }
  .partner-grid { display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid var(--line); border-left:1px solid var(--line); }
  .partner-grid div { min-height:150px; display:grid; place-items:center; padding:22px; border-right:1px solid var(--line); border-bottom:1px solid var(--line); background:white; }
  .partner-grid img { max-width:100%; max-height:72px; object-fit:contain; filter:grayscale(1); }
  .final-cta { background:var(--ink); color:white; padding:70px 5vw; display:flex; align-items:center; justify-content:space-between; gap:30px; }
  .final-cta p { font:400 clamp(2rem,4vw,5rem)/1 "Archivo Black"; text-transform:uppercase; margin:0; max-width:900px; }
  .final-cta a { background:var(--acid); color:var(--ink); padding:20px 24px; text-decoration:none; font-weight:700; text-transform:uppercase; flex:none; }
  footer { background:#020d14; color:#aab8bf; padding:65px 5vw 28px; }
  .footer-top { display:flex; justify-content:space-between; align-items:center; padding-bottom:38px; border-bottom:1px solid #2d414b; }
  .footer-top img { width:auto; height:68px; filter:brightness(0) invert(1); }
  .footer-top a { color:var(--acid); }
  .footer-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:50px; padding:45px 0; }
  .footer-grid h2 { color:white; font:700 1rem "Space Grotesk"; text-transform:uppercase; letter-spacing:.08em; }
  .footer-bottom { border-top:1px solid #2d414b; padding-top:22px; font-size:.85rem; }
  @media(max-width:950px) {
    header nav { display:none; }
    .nav-cta { margin-left:auto; }
    .hero-main { grid-template-columns:1fr; }
    .hero-image { min-height:440px; clip-path:none; }
    .intro,.section-title,.invest-heading { grid-template-columns:1fr; }
    .intro { gap:25px; }
    .product-grid,.invest-grid { grid-template-columns:repeat(2,1fr); }
    .invest-grid article:nth-child(2) { border-right:0; }
    .invest-grid article:nth-child(-n+2) { border-bottom:2px solid var(--ink); }
    .mdrt,.partner-section { grid-template-columns:1fr; }
    .mdrt-art { min-height:230px; }
    .partner-section>div:first-child { max-width:700px; }
  }
  @media(max-width:600px) {
    header { height:72px; padding:0 16px; }
    .logo img { width:auto; height:44px; }
    .nav-cta { font-size:0; padding:11px; }
    .nav-cta::after { content:"WhatsApp"; font-size:.78rem; }
    .hero-copy { padding:70px 20px; }
    h1 { font-size:clamp(3.25rem,14vw,4.35rem); }
    .hero-image { min-height:380px; }
    .stamp { width:140px; }
    .stamp strong { font-size:3rem; }
    .stamp span { font-size:.72rem; }
    .intro,.products,.invest,.mdrt,.partner-section { padding-left:20px; padding-right:20px; }
    .invest h2,.partner-section h2 { font-size:2.4rem; overflow-wrap:anywhere; }
    .product-grid,.invest-grid { grid-template-columns:1fr; }
    .product-grid article { min-height:350px; }
    .invest-grid article,.invest-grid article:nth-child(2),.invest-grid article:nth-child(-n+2) { border-right:0; border-bottom:2px solid var(--ink); }
    .invest-grid article:last-child { border-bottom:0; }
    .official { gap:22px; }
    .official img { max-width:100px; }
    .partner-grid { grid-template-columns:repeat(2,1fr); }
    .final-cta { flex-direction:column; align-items:flex-start; padding:55px 20px; }
    .footer-grid { grid-template-columns:1fr; gap:25px; }
    .footer-top { align-items:flex-start; flex-direction:column; gap:20px; }
  }
  :focus-visible { outline:3px solid #c8ff36; outline-offset:4px; }
</style>
