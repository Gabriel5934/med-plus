---
import family from "../assets/family.jpg";
import logo from "../assets/medplus-mark.svg";
import coin from "../assets/bootstrap/coin.svg";
import people from "../assets/bootstrap/people.svg";
import stethoscope from "../assets/bootstrap/heart-pulse.svg";
import doctor from "../assets/bootstrap/person-badge.svg";
import piggy from "../assets/bootstrap/piggy-bank.svg";
import plane from "../assets/bootstrap/airplane.svg";
import life from "../assets/bootstrap/hospital.svg";
import hand from "../assets/bootstrap/hand-index-thumb.svg";
import handPng from "../assets/bootstrap/hand-index-thumb.svg";
import globe from "../assets/bootstrap/globe-americas.svg";
import bank from "../assets/bootstrap/bank.svg";
import shield from "../assets/bootstrap/shield-check.svg";
import partner1 from "../assets/partners/1.png";
import partner2 from "../assets/partners/2.png";
import partner3 from "../assets/partners/3.png";
import partner4 from "../assets/partners/4.png";
import partner5 from "../assets/partners/5.png";
import partner6 from "../assets/partners/6.webp";
import partner7 from "../assets/partners/7.svg";
import rc1 from "../assets/rc/1.png";
import rc2 from "../assets/rc/2.png";
import rc3 from "../assets/rc/3.png";
import rc4 from "../assets/rc/4.png";
import rc5 from "../assets/rc/5.webp";
import rc6 from "../assets/rc/6.png";

const products = [
  { icon: coin, title: "Seguro de Renda", text: "Se você precisar se afastar do trabalho por doença, acidente ou cirurgia, o seguro ajuda a manter sua renda mensal. Assim, seus compromissos financeiros continuam atendidos enquanto você se dedica ao tratamento e à recuperação." },
  { icon: people, title: "Seguro de Vida", text: "Além da proteção aos beneficiários, pode incluir coberturas usadas em vida, como invalidez por acidente ou doença, auxílio funeral e incapacidade temporária." },
  { icon: stethoscope, title: "Seguro de Doenças Graves — DG30", text: "Oferece ajuda financeira após o diagnóstico de doenças graves. O recurso pode apoiar o tratamento, manter as contas em dia e preservar o padrão de vida em um momento sensível." },
  { icon: doctor, title: "Responsabilidade Civil Profissional", text: "Protege diante de reclamações e ações judiciais por danos involuntários. Entre as coberturas estão custos de defesa, honorários, indenizações e acordos judiciais ou extrajudiciais." },
  { icon: piggy, title: "Previdência Privada Complementar", text: "Uma estratégia para acumular e investir recursos ao longo do tempo, buscando uma aposentadoria compatível com seus objetivos e perfil financeiro." },
  { icon: plane, title: "Seguro Viagem", text: "Proteção em viagens de lazer ou negócios, com coberturas que podem incluir acidentes pessoais, assistência médica e odontológica, remoção e extravio de bagagem." },
  { icon: life, title: "Seguro Saúde Nacional e Global", text: "Análise de opções em seguradoras nacionais e internacionais para encontrar uma alternativa coerente com seu perfil e suas necessidades." },
  { icon: hand, title: "Seguro das Mãos", text: "Proteção por invalidez permanente total por acidente majorada, criada para preservar a autonomia financeira de profissionais que dependem das mãos para produzir renda." },
];
const investments = [
  { icon: handPng, title: "P2P Lending", text: "Uma alternativa com rentabilidades atrativas e liquidez de curto e médio prazo para quem busca equilibrar resultado e acesso ao capital." },
  { icon: shield, title: "Conta Corrente Protegida", text: "Conta bancária internacional para realizar transações em outros países e facilitar a compra de moedas para viagens futuras." },
  { icon: globe, title: "Conta de Investimento Internacional", text: "Acesso a portfólios globais, diversificação em moedas fortes e acompanhamento especializado para investir em diferentes mercados." },
  { icon: bank, title: "Correspondente Bancário Nacional", text: "Soluções bancárias nacionais com a proximidade de um atendimento consultivo." },
];
const partners = [partner1, partner2, partner3, partner4, partner5, partner6, partner7];
const rcPartners = [rc1, rc2, rc3, rc4, rc5, rc6];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Há mais de 25 anos, a Med Plus oferece consultoria independente em seguros e investimentos." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Med Plus — Versão Acolhedora</title>
  </head>
  <body>
    <div class="notice"><span>Consultoria independente em seguros</span><a href="tel:+551236337199">(12) 3633-7199</a><a href="https://www.instagram.com/medpluscorretora/">Instagram ↗</a></div>
    <header>
      <a class="logo" href="#inicio"><img src={logo.src} alt="Med Plus Corretora de Seguros" /></a>
      <nav aria-label="Navegação principal"><a href="#como-funciona">Como ajudamos</a><a href="#solucoes">Soluções</a><a href="#parceiros">Parceiros</a></nav>
      <a class="header-cta" href="https://wa.me/5512996146999">Agendar uma conversa</a>
    </header>

    <main>
      <section class="hero wrap" id="inicio">
        <div class="hero-copy"><p class="eyebrow">Cuidado para cada fase da vida</p><h1>Boas escolhas começam com uma <em>boa conversa.</em></h1><p>Há mais de 25 anos, ajudamos pessoas e profissionais a proteger o que construíram e planejar o que ainda está por vir.</p><div class="hero-actions"><a class="button" href="https://wa.me/5512996146999">Fale com um consultor</a><a href="#solucoes">Explore as soluções</a></div><div class="mini-proof"><span><strong>25+</strong> anos de experiência</span><span><strong>100%</strong> consultoria independente</span></div></div>
        <div class="hero-visual"><div class="photo" style={`--photo: url(${family.src})`}></div><div class="quote"><span>“</span><p>Mais do que indicar um seguro, queremos entender o que realmente faz sentido para você.</p></div></div>
      </section>

      <section class="process" id="como-funciona"><div class="wrap"><div class="process-intro"><p class="eyebrow">Nosso jeito de cuidar</p><h2>Consultoria antes da escolha.</h2></div><div class="steps"><article><span>01</span><h3>Escutamos</h3><p>Entendemos seu momento, seus objetivos e o que precisa de proteção.</p></article><article><span>02</span><h3>Comparamos</h3><p>Analisamos soluções das principais seguradoras com independência.</p></article><article><span>03</span><h3>Recomendamos</h3><p>Apresentamos alternativas coerentes com seu perfil e acompanhamos você.</p></article></div></div></section>

      <section class="solutions wrap" id="solucoes">
        <div class="center-head"><p class="eyebrow">Seguros</p><h2>Proteção para a vida real.</h2><p>Cada solução parte de uma necessidade diferente. Abra os itens abaixo para conhecer as possibilidades.</p></div>
        <div class="accordion">
          {products.map((item, index) => (
            <details open={index === 0}>
              <summary><span class="index">0{index + 1}</span><img src={item.icon.src} alt="" /><strong>{item.title}</strong><span class="plus" aria-hidden="true">+</span></summary>
              <div class="detail-body"><p>{item.text}</p>{item.title === "Responsabilidade Civil Profissional" ? <a href="https://www.rc4vc.com/cotacao/medplus" target="_blank" rel="noreferrer">Fazer cotação RCP on-line ↗</a> : <a href="https://wa.me/5512996146999">Conversar sobre esta solução ↗</a>}</div>
            </details>
          ))}
        </div>
      </section>

      <section class="investments"><div class="wrap"><div class="invest-head"><div><p class="eyebrow">Investimentos</p><h2>Olhar global.<br /><em>Relação próxima.</em></h2></div><p>Possibilidades para diversificar e proteger seu patrimônio, sempre conectadas ao seu perfil e horizonte.</p></div><div class="invest-grid">{investments.map((item) => <article><div class="icon"><img src={item.icon.src} alt="" /></div><h3>{item.title}</h3><p>{item.text}</p><a href="https://wa.me/5512996146999">Quero entender melhor ↗</a></article>)}</div></div></section>

      <section class="mdrt wrap"><div class="mdrt-wordmark" aria-label="MDRT, marca registrada">MDRT<sup>®</sup></div><div><p class="eyebrow">Excelência reconhecida</p><h2>Membro do MDRT<sup>®</sup></h2><p>A Med Plus faz parte de uma associação exclusiva de corretores de seguros com mais de <strong>US$ 1 milhão em seguro de vida.</strong></p></div></section>

      <section class="partners" id="parceiros"><div class="wrap"><div class="center-head"><p class="eyebrow">Nossa rede</p><h2>Independência para comparar.<br />Experiência para orientar.</h2></div><div class="logos">{partners.map((partner) => <div><img src={partner.src} alt="Seguradora parceira" loading="lazy" /></div>)}</div><div class="rc-block"><div><p class="eyebrow">Responsabilidade Civil Profissional</p><h3>Especialistas ao seu lado.</h3><a class="button" href="https://www.rc4vc.com/cotacao/medplus" target="_blank" rel="noreferrer">Faça sua cotação on-line</a></div><div class="rc-logos">{rcPartners.map((partner) => <img src={partner.src} alt="Parceiro de responsabilidade civil profissional" loading="lazy" />)}</div></div></div></section>

      <section class="final wrap"><div><p class="eyebrow">Estamos prontos para ouvir</p><h2>Como podemos ajudar você?</h2></div><div><a class="button dark" href="https://wa.me/5512996146999">Fale pelo WhatsApp</a><p>(12) 99614-6999<br />medpluscorretora@medpluscorretora.com.br</p></div></section>
    </main>

    <footer><div class="wrap footer-grid"><div><img src={logo.src} alt="Med Plus" /><p>Proteção com escuta, experiência e independência.</p></div><div><h2>Taubaté</h2><p>Rua Dr. Souza Alves, 384 — Sala 504<br />Centro — Taubaté — SP</p></div><div><h2>São José dos Campos</h2><p>Rua Euclides Miragaia, 145 — Sala 610<br />Centro — São José dos Campos — SP</p></div></div><div class="wrap footer-bottom"><span>© 2026 Med Plus Corretora de Seguros.</span><a href="https://www.instagram.com/medpluscorretora/">@medpluscorretora ↗</a></div></footer>
  </body>
</html>

<style is:global>
  :root { --navy:#14374b; --blue:#0878b7; --cyan:#d9f2f4; --cream:#fbf7ef; --peach:#f4d8bd; --orange:#e46f3f; --ink:#1f3640; --muted:#64767d; --line:#d8dfdc; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:var(--cream); color:var(--ink); font:400 16px/1.7 "Plus Jakarta Sans",sans-serif; }
  a { color:inherit; }
  img { max-width:100%; }
  h1,h2,h3,p { margin-top:0; }
  h1,h2 { font-family:"Instrument Serif",serif; font-weight:400; line-height:.98; letter-spacing:-.035em; }
  h1 { font-size:clamp(4rem,7.4vw,7.6rem); }
  h2 { font-size:clamp(3rem,5.8vw,5.7rem); }
  h1 em,h2 em { color:var(--blue); }
  .wrap { width:min(1160px,calc(100% - 40px)); margin-inline:auto; }
  .notice { min-height:38px; padding:8px max(20px,calc((100vw - 1160px)/2)); background:var(--navy); color:#deedf1; display:flex; gap:28px; align-items:center; font-size:.78rem; letter-spacing:.04em; }
  .notice span { margin-right:auto; text-transform:uppercase; }
  header { height:84px; padding:0 max(20px,calc((100vw - 1160px)/2)); display:flex; gap:38px; align-items:center; background:rgba(251,247,239,.94); position:sticky; top:0; z-index:10; border-bottom:1px solid rgba(20,55,75,.1); backdrop-filter:blur(12px); }
  .logo img { width:auto; height:52px; display:block; }
  header nav { display:flex; gap:28px; margin-left:auto; }
  header nav a { text-decoration:none; font-weight:600; font-size:.9rem; }
  .header-cta,.button { display:inline-flex; min-height:50px; align-items:center; justify-content:center; padding:13px 22px; border-radius:999px; background:var(--blue); color:white; text-decoration:none; font-weight:700; }
  .hero { padding-block:clamp(60px,8vw,120px); display:grid; grid-template-columns:1.05fr .95fr; gap:clamp(40px,7vw,100px); align-items:center; }
  .eyebrow { margin-bottom:20px; text-transform:uppercase; letter-spacing:.16em; font-size:.73rem; font-weight:700; color:var(--orange); }
  .hero-copy>p:not(.eyebrow) { max-width:630px; color:var(--muted); font-size:clamp(1.05rem,1.6vw,1.25rem); }
  .hero-actions { display:flex; gap:24px; align-items:center; flex-wrap:wrap; margin-top:35px; }
  .hero-actions>a:last-child { font-weight:700; text-underline-offset:5px; }
  .mini-proof { margin-top:55px; padding-top:26px; border-top:1px solid var(--line); display:flex; gap:40px; color:var(--muted); font-size:.88rem; }
  .mini-proof strong { color:var(--navy); font-size:1.15rem; }
  .hero-visual { position:relative; padding:0 0 70px 50px; }
  .photo { min-height:650px; background:var(--photo) 42% center/cover; border-radius:190px 190px 20px 20px; box-shadow:0 28px 70px rgba(33,73,91,.16); }
  .quote { position:absolute; left:0; bottom:0; width:min(390px,88%); padding:26px 30px; background:white; border-radius:18px; box-shadow:0 15px 40px rgba(33,73,91,.14); display:flex; gap:16px; }
  .quote span { font:400 4rem/1 "Instrument Serif"; color:var(--orange); }
  .quote p { margin:0; font-size:.95rem; }
  .process { background:var(--cyan); padding-block:clamp(80px,9vw,130px); }
  .process>.wrap { display:grid; grid-template-columns:.75fr 1.25fr; gap:8vw; }
  .steps { border-top:1px solid #aecfd2; }
  .steps article { display:grid; grid-template-columns:50px 150px 1fr; gap:22px; align-items:baseline; padding:27px 0; border-bottom:1px solid #aecfd2; }
  .steps span { color:var(--blue); font-size:.8rem; }
  .steps h3 { font-size:1.25rem; }
  .steps p { margin:0; color:#527076; }
  .solutions { padding-block:clamp(90px,11vw,160px); }
  .center-head { text-align:center; max-width:830px; margin:0 auto 60px; }
  .center-head>p:last-child { max-width:650px; margin:20px auto 0; color:var(--muted); }
  .accordion { border-top:1px solid var(--line); }
  details { border-bottom:1px solid var(--line); }
  summary { min-height:105px; list-style:none; display:grid; grid-template-columns:50px 58px 1fr 30px; gap:24px; align-items:center; cursor:pointer; }
  summary::-webkit-details-marker { display:none; }
  summary .index { font-size:.77rem; color:#849398; }
  summary img { width:48px; height:48px; object-fit:contain; }
  summary strong { font:400 clamp(1.35rem,2.8vw,2.1rem) "Instrument Serif",serif; }
  summary .plus { font-size:1.8rem; color:var(--blue); transition:.2s; }
  details[open] .plus { transform:rotate(45deg); }
  .detail-body { padding:0 54px 35px 132px; max-width:900px; }
  .detail-body p { color:var(--muted); }
  .detail-body a { font-weight:700; color:var(--blue); text-underline-offset:4px; }
  .investments { padding-block:clamp(90px,10vw,150px); background:var(--navy); color:white; }
  .invest-head { display:grid; grid-template-columns:1.2fr .8fr; gap:8vw; align-items:end; margin-bottom:60px; }
  .invest-head>p { color:#bed0d8; font-size:1.08rem; }
  .invest-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:18px; }
  .invest-grid article { min-height:350px; padding:34px; background:#1d485d; border-radius:20px; display:flex; flex-direction:column; }
  .invest-grid article:nth-child(2),.invest-grid article:nth-child(3) { background:#28566a; }
  .icon { width:70px; height:70px; display:grid; place-items:center; border-radius:50%; background:var(--cyan); }
  .icon img { width:42px; height:42px; object-fit:contain; }
  .invest-grid h3 { margin:42px 0 12px; font-size:1.45rem; }
  .invest-grid p { color:#c1d1d8; }
  .invest-grid a { margin-top:auto; color:#a7e8ee; font-weight:700; text-underline-offset:4px; }
  .mdrt { padding-block:90px; display:grid; grid-template-columns:240px 1fr; gap:70px; align-items:center; }
  .mdrt-wordmark { font:700 clamp(4rem,7vw,6.8rem)/.85 "Instrument Serif",Georgia,serif; letter-spacing:-.07em; color:var(--navy); }
  .mdrt-wordmark sup,.mdrt h2 sup { font:700 .2em/1 "Plus Jakarta Sans",sans-serif; letter-spacing:0; vertical-align:top; margin-left:.12em; }
  .mdrt h2 { margin-bottom:18px; }
  .mdrt p:last-child { font-size:1.2rem; color:var(--muted); max-width:700px; }
  .mdrt strong { color:var(--blue); }
  .partners { padding-block:clamp(90px,10vw,140px); background:#f1e7d6; }
  .logos { display:grid; grid-template-columns:repeat(7,1fr); gap:12px; }
  .logos div { min-height:130px; padding:22px; background:white; border-radius:14px; display:grid; place-items:center; }
  .logos img { max-height:66px; object-fit:contain; filter:grayscale(1); }
  .rc-block { margin-top:60px; padding:48px; border-radius:24px; background:var(--peach); display:grid; grid-template-columns:.8fr 1.2fr; gap:50px; align-items:center; }
  .rc-block h3 { font:400 3rem/1 "Instrument Serif"; margin-bottom:28px; }
  .rc-logos { display:grid; grid-template-columns:repeat(3,1fr); gap:15px; align-items:center; }
  .rc-logos img { width:100%; height:70px; object-fit:contain; mix-blend-mode:multiply; }
  .final { margin-block:100px; padding:60px; background:var(--blue); color:white; border-radius:28px; display:grid; grid-template-columns:1.2fr .8fr; gap:60px; align-items:center; }
  .final .eyebrow { color:#bcecf3; }
  .final h2 { margin-bottom:0; }
  .final .dark { background:var(--navy); }
  .final div:last-child p { margin:20px 0 0; color:#d7edf5; }
  footer { padding:70px 0 25px; background:#102d3c; color:#b9cbd3; }
  .footer-grid { display:grid; grid-template-columns:1.2fr 1fr 1fr; gap:60px; }
  .footer-grid img { width:auto; height:68px; filter:brightness(0) invert(1); }
  .footer-grid h2 { color:white; font:600 1rem "Plus Jakarta Sans"; }
  .footer-bottom { margin-top:55px; padding-top:22px; border-top:1px solid #34505f; display:flex; justify-content:space-between; font-size:.85rem; }
  @media(max-width:900px) {
    header nav { display:none; }
    .header-cta { margin-left:auto; }
    .hero,.process>.wrap,.invest-head,.rc-block,.final { grid-template-columns:1fr; }
    .hero-visual { max-width:650px; margin:auto; }
    .process-intro { max-width:600px; }
    .logos { grid-template-columns:repeat(4,1fr); }
    .footer-grid { grid-template-columns:1fr 1fr; }
  }
  @media(max-width:600px) {
    .wrap { width:min(100% - 28px,1160px); }
    .notice { padding-inline:14px; }
    .notice span,.notice a:last-child { display:none; }
    .notice a { margin-left:auto; }
    header { height:72px; padding-inline:14px; }
    .logo img { width:auto; height:44px; }
    .header-cta { padding:10px 13px; min-height:42px; font-size:.78rem; }
    .hero { padding-top:55px; }
    h1 { font-size:clamp(4rem,18vw,5.6rem); }
    .mini-proof { gap:22px; }
    .hero-visual { padding-left:15px; }
    .photo { min-height:500px; border-radius:130px 130px 18px 18px; }
    .quote { padding:20px; }
    .steps article { grid-template-columns:35px 1fr; gap:10px; }
    .steps p { grid-column:2; }
    summary { min-height:90px; grid-template-columns:30px 42px 1fr 24px; gap:12px; }
    summary img { width:38px; height:38px; }
    .detail-body { padding:0 12px 30px 84px; }
    .invest-grid { grid-template-columns:1fr; }
    .mdrt { grid-template-columns:1fr; text-align:center; gap:25px; }
    .mdrt-wordmark { margin:auto; }
    .logos { grid-template-columns:repeat(2,1fr); }
    .rc-block { padding:28px; }
    .rc-logos { grid-template-columns:repeat(2,1fr); }
    .final { width:100%; margin-block:0; border-radius:0; padding:55px 20px; }
    .footer-grid { grid-template-columns:1fr; gap:30px; }
    .footer-bottom { flex-direction:column; gap:12px; }
  }
  :focus-visible { outline:3px solid var(--orange); outline-offset:4px; }
</style>
